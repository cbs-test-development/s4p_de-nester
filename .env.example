# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Every variable read by src/app/config.py belongs here, documented, with a
# safe placeholder value. This file is the contract: if it is not listed here,
# the service does not read it.

# Service identity, used in logs.
APP_NAME=s4p-de-nester

# Deployment environment: local | dev | test | production
APP_ENV=local

# Root logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Add real settings below. Never commit secrets - put placeholders here and
# supply actual values through the environment or your secret store.
